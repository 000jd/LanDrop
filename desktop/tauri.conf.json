{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LanDrop",
  "version": "0.2.0",
  "identifier": "dev.landrop.app",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "devUrl": "http://127.0.0.1:8420",
    "frontendDist": "../ui"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "appimage"],
    "icon": [
      "../assets/icon-32.png",
      "../assets/icon-128.png",
      "../assets/icon.png",
      "../assets/icon-512.png",
      "../assets/icon.ico",
      "../assets/icon.icns",
      "../assets/icon.svg"
    ],
    "linux": {
      "deb": {
        "depends": [],
        "files": {
          "/usr/share/icons/hicolor/scalable/apps/landrop-desktop.svg": "../assets/icon.svg"
        }
      },
      "rpm": {
        "files": {
          "/usr/share/icons/hicolor/scalable/apps/landrop-desktop.svg": "../assets/icon.svg"
        }
      },
      "appimage": {
        "files": {
          "/usr/share/icons/hicolor/scalable/apps/landrop-desktop.svg": "../assets/icon.svg"
        }
      }
    }
  }
}
